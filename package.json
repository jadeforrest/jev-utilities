{
  "name": "jev-utilities",
  "version": "0.1.0",
  "description": "Small helpers for categorizing data with TypeSafe's Jev decision model",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jev-categorize": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "categorize": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "coverage": "c8 --reporter=text --reporter=json-summary --include 'src/**' tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/node": "^22.20.5",
    "c8": "^10.1.3",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
